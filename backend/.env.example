# ─── 基础 ───
DATABASE_URL=sqlite:///./emission.db
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_NAME=发电厂环保排放在线监测系统
APP_VERSION=1.0.0
DEBUG=false

# CORS 允许的前端 origin，JSON 数组格式；不配则用默认开发口
# ALLOWED_ORIGINS=["http://localhost:5176","https://emission.example.com"]

# ─── 排放限值（火电厂超低排放 GB13223-2011，折算到 6% 基准氧）───
REFERENCE_O2=6.0
LIMIT_SO2=35.0
LIMIT_NOX=50.0
LIMIT_DUST=10.0

# 严重超标判定倍数
SEVERE_MULTIPLE=1.5

# 持续超标升级阈值（分钟）
PERSIST_ESCALATE_MINUTES=30

# CEMS 月在线率合规线
CEMS_AVAILABILITY_TARGET=0.95

# ─── 与兄弟系统集成（v2 启用，v1 留空）───
INTEGRATION_SECRET=coal-integration-shared-secret
SAFETY_SYSTEM_URL=
INSPECTION_SYSTEM_URL=
